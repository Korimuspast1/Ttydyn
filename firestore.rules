rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return signedIn()
        && exists(chatPath)
        && request.auth.uid in get(chatPath).data.members;
    }

    function validUsername(value) {
      return value is string
        && value.matches('^[a-z][a-z0-9_]{2,30}[a-z0-9]$')
        && value != 'duckgomz';
    }

    match /usernames/{usernameId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && validUsername(usernameId)
        && request.resource.data.keys().hasOnly(['uid', 'username'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == usernameId
        && !exists(/databases/$(database)/documents/usernames/$(usernameId));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt'])
        && request.resource.data.uid == userId
        && validUsername(request.resource.data.username)
        && request.resource.data.usernameLower == request.resource.data.username
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'title', 'members', 'memberNames', 'createdBy',
          'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessage', 'lastSenderId'
        ])
        && request.resource.data.type in ['direct', 'group']
        && request.resource.data.title is string
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasAll(request.resource.data.members)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderId == ''
        && ((request.resource.data.type == 'direct'
              && request.resource.data.members.size() == 2
              && request.resource.data.title == '')
            || (request.resource.data.type == 'group'
              && request.resource.data.title.size() > 0
              && request.resource.data.title.size() <= 64));
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.keys().hasOnly([
          'type', 'title', 'members', 'memberNames', 'createdBy',
          'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessage', 'lastSenderId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'members', 'memberNames', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastSenderId'
        ])
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= 20
        && (request.resource.data.type != 'direct' || request.resource.data.members.size() == 2)
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasAll(request.resource.data.members)
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.type != 'group'
            || (request.resource.data.title is string
              && request.resource.data.title.size() > 0
              && request.resource.data.title.size() <= 64))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastMessageAt', 'lastSenderId'])
            || (request.resource.data.lastSenderId == request.auth.uid
              && request.resource.data.lastMessage is string
              && request.resource.data.lastMessage.size() <= 120
              && request.resource.data.lastMessageAt == request.time));
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderUsername', 'type', 'text', 'filePath',
            'fileName', 'mimeType', 'fileSize', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && validUsername(request.resource.data.senderUsername)
          && request.resource.data.senderUsername == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.createdAt == request.time
          && ((request.resource.data.type == 'text'
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 4096
                && request.resource.data.filePath == ''
                && request.resource.data.fileName == ''
                && request.resource.data.mimeType == ''
                && request.resource.data.fileSize == 0)
              || (request.resource.data.type == 'file'
                && request.resource.data.text == ''
                && request.resource.data.filePath == 'chatAttachments/' + chatId + '/' + messageId
                && request.resource.data.fileName is string
                && request.resource.data.fileName.size() > 0
                && request.resource.data.fileName.size() <= 255
                && request.resource.data.mimeType is string
                && request.resource.data.mimeType.size() <= 128
                && request.resource.data.fileSize is int
                && request.resource.data.fileSize >= 0
                && request.resource.data.fileSize <= 20 * 1024 * 1024));
        allow update, delete: if false;
      }
    }
  }
}
