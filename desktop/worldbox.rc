#include <winver.h>

1 ICON "desktop/worldbox.ico"
1 24 "desktop/worldbox.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,6,0,0
PRODUCTVERSION 3,6,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Ttydyn Games"
      VALUE "FileDescription", "WorldBox Sandbox - 2D Pixel God Simulator (PC Edition)"
      VALUE "FileVersion", "3.6.0.0"
      VALUE "InternalName", "WorldBox-Sandbox"
      VALUE "OriginalFilename", "WorldBox-Sandbox.exe"
      VALUE "ProductName", "WorldBox Sandbox PC Edition"
      VALUE "ProductVersion", "3.6.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
